+def _resize_images_like_env(images, env_pixels):
+    target_shape = env_pixels.shape[2:]
+    if images.shape[1:] == target_shape:
+        return images
+
+    target_h, target_w = target_shape[:2]
+    resample = getattr(Image, 'Resampling', Image).BILINEAR
+    resized = [
+        np.asarray(Image.fromarray(img).resize((target_w, target_h), resample))
+        for img in images
+    ]
+    return np.stack(resized).astype(images.dtype, copy=False)
