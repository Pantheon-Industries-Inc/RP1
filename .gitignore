# --- regenerable / environment ---------------------------------------------
.venv/
__pycache__/
*.pyc
.DS_Store

# stable-worldmodel is VENDORED (not a submodule): its working tree carries 9
# modified + 29 untracked files -- including solver/lip.py, train_lip_ac.py and
# config/solver/lip.yaml, i.e. the whole LIP implementation, which exists in NO
# upstream commit. A submodule pin would ship a tree with no LIP in it.
# Upstream base: galilai-group/stable-worldmodel @ b298aa70.
stable-worldmodel/.git/
stable-worldmodel/.venv/

# --- large archives (redundant snapshots of content already tracked) --------
*.tgz
*.tar.gz
*.tar.zst
*.zip
# ...except the checkpoint store: pushed in full via LFS (2026-08-04), so the
# authors' pretrained .tar.zst bases ride along. tworoom_lip4.zip stays out
# (duplicate of the adjacent tracked dir).
!stable-worldmodel/checkpoints/**/*.tar.zst

# --- individual files over GitHub's hard 100 MB limit -----------------------
# (kept out so a push can never be rejected mid-transfer; the checkpoint
# store's >100MB files are exempt because .gitattributes routes them via LFS)
pod_archive/poda_20260715/lewm_cube_negatives/
previous/pod_migration_20260709/pod_bundle_20260709.tgz
