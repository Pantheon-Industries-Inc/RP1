+def restrict_and_select(dataset, col_name, valid_indices, cfg_eval, seed):
+    """RLP campaign hook: held-out episode filter + shared explicit task list.
+
+    ``eval.episode_min`` / ``eval.episode_max`` restrict evaluation starts to an
+    episode range, so an arm can be scored on episodes the models never trained
+    on (the shipped configs draw from the training split). ``eval.row_indices_file``
+    overrides sampling entirely with a newline-separated list of dataset row
+    indices, so two arms can be compared paired, episode-for-episode, instead of
+    relying on two RNG call patterns agreeing.
+    """
+    import numpy as _np
+
+    valid_indices = _np.asarray(valid_indices)
+    ep_min = cfg_eval.get("episode_min", None)
+    ep_max = cfg_eval.get("episode_max", None)
+    if ep_min is not None or ep_max is not None:
+        ep_col = _np.asarray(dataset.get_col_data(col_name)).reshape(-1)
+        eps = ep_col[valid_indices]
+        keep = _np.ones(len(valid_indices), dtype=bool)
+        if ep_min is not None:
+            keep &= eps >= int(ep_min)
+        if ep_max is not None:
+            keep &= eps < int(ep_max)
+        valid_indices = valid_indices[keep]
+        print(
+            f"{len(valid_indices)} valid starting points after episode filter "
+            f"[{ep_min}, {ep_max})"
+        )
 
+    rows_file = cfg_eval.get("row_indices_file", None)
+    if rows_file:
+        rows = _np.loadtxt(str(rows_file), dtype=_np.int64, ndmin=1)
+        missing = _np.setdiff1d(rows, valid_indices)
+        if len(missing):
+            raise ValueError(
+                f"row_indices_file lists {len(missing)} rows that are not valid "
+                f"evaluation starts under this config (first: {missing[:5].tolist()})"
+            )
+        print(f"using {len(rows)} explicit evaluation rows from {rows_file}")
+        return _np.sort(rows)
 
+    num_eval = int(cfg_eval.num_eval)
+    if len(valid_indices) < num_eval:
+        raise ValueError(
+            f"Not enough valid starting points: requested {num_eval}, "
+            f"found {len(valid_indices)}."
+        )
+    g = _np.random.default_rng(int(seed))
+    return _np.sort(valid_indices[g.choice(len(valid_indices), size=num_eval, replace=False)])
+
+
+def install_world_compat():
+    """Bind ``World.evaluate_from_dataset`` when the installed swm lacks it.
+
+    This artifact's code targets a stable-worldmodel source checkout where
+    ``evaluate_from_dataset`` was public. Released swm (0.1.0/0.1.1, the only
+    versions on PyPI) exposes the dataset path as ``World.evaluate(dataset=...)``
+    and keeps ``_evaluate_from_dataset`` private, so the shipped code dies with
+    "'World' object has no attribute 'evaluate_from_dataset'". The kwargs also
+    drifted: goal_offset_steps -> goal_offset, video_path -> video. Map them onto
+    the public entry point, which returns the same
+    {'success_rate', 'episode_successes', 'seeds'} contract the callers expect.
+    """
+    import stable_worldmodel as _swm
+
+    if hasattr(_swm.World, "evaluate_from_dataset"):
+        return
+
+    def evaluate_from_dataset(
+        self,
+        dataset,
+        *,
+        start_steps,
+        goal_offset_steps,
+        eval_budget,
+        episodes_idx,
+        callables=None,
+        video_path=None,
+        **_ignored,
+    ):
+        return self.evaluate(
+            dataset=dataset,
+            episodes_idx=episodes_idx,
+            start_steps=start_steps,
+            goal_offset=goal_offset_steps,
+            eval_budget=eval_budget,
+            callables=callables,
+            video=video_path,
+        )
+
+    _swm.World.evaluate_from_dataset = evaluate_from_dataset
+
+
+install_world_compat()
+
