name: CI

on:
  push:
  pull_request:

jobs:
  checks:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: prefix-dev/setup-pixi@v0.9.3
        with:
          cache: true
          environments: dev
      - run: pixi run -e dev check
      - name: Build wheel and verify installed config discovery
        run: |
          pixi run -e dev python -m pip wheel --no-deps --no-build-isolation --wheel-dir dist .
          pixi run -e dev python -m venv --system-site-packages /tmp/rlp-wheel-smoke
          /tmp/rlp-wheel-smoke/bin/pip install --no-deps dist/rlp-*.whl
          cd /tmp
          /tmp/rlp-wheel-smoke/bin/python -c "from rlp.eval.__main__ import run"
