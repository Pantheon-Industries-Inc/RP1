{
  "output_model_name": "mix_plain_roll",
  "subdir": "mix_plain_roll",
  "num_workers": 12,
  "train_split": 0.9,
  "seed": 3072,
  "img_size": 224,
  "patch_size": 14,
  "encoder_scale": "tiny",
  "embed_dim": 192,
  "encoder_resnet9": false,
  "train_value_function": false,
  "projector_loss_weight": 0.001,
  "dump_object": true,
  "trainer": {
    "max_epochs": 22,
    "devices": 4,
    "accelerator": "gpu",
    "precision": "bf16",
    "gradient_clip_val": 1.0
  },
  "loader": {
    "batch_size": 32,
    "num_workers": 12,
    "drop_last": true,
    "persistent_workers": true,
    "prefetch_factor": 3,
    "pin_memory": true,
    "shuffle": true
  },
  "optimizer": {
    "type": "AdamW",
    "lr": 5e-05,
    "weight_decay": 0.001
  },
  "wm": {
    "history_size": 3,
    "num_preds": 5,
    "rollout_len": 5,
    "rollout_weight": 1.0
  },
  "model": {
    "_target_": "stable_worldmodel.wm.lewm.LeWM",
    "encoder": {
      "_target_": "stable_pretraining.backbone.utils.vit_hf",
      "size": "tiny",
      "patch_size": 14,
      "image_size": 224,
      "pretrained": false,
      "use_mask_token": false
    },
    "predictor": {
      "_target_": "stable_worldmodel.wm.lewm.module.Predictor",
      "num_frames": 3,
      "input_dim": 192,
      "hidden_dim": 192,
      "output_dim": 192,
      "depth": 6,
      "heads": 16,
      "mlp_dim": 2048,
      "dim_head": 64,
      "dropout": 0.1,
      "emb_dropout": 0.0
    },
    "action_encoder": {
      "_target_": "stable_worldmodel.wm.lewm.module.Embedder",
      "input_dim": 25,
      "emb_dim": 192
    },
    "projector": {
      "_target_": "stable_worldmodel.wm.lewm.module.MLP",
      "input_dim": 192,
      "output_dim": 192,
      "hidden_dim": 2048,
      "norm_fn": {
        "_target_": "torch.nn.BatchNorm1d",
        "_partial_": true
      }
    },
    "pred_proj": {
      "_target_": "stable_worldmodel.wm.lewm.module.MLP",
      "input_dim": 192,
      "output_dim": 192,
      "hidden_dim": 2048,
      "norm_fn": {
        "_target_": "torch.nn.BatchNorm1d",
        "_partial_": true
      }
    }
  },
  "loss": {
    "sigreg": {
      "weight": 0.09,
      "kwargs": {
        "knots": 17,
        "num_proj": 1024
      }
    }
  },
  "n_gpus": 1,
  "cpus_per_task": 8,
  "cache_dir": null,
  "wandb": {
    "enabled": false,
    "config": {
      "entity": "stable-wm",
      "project": "stable-wm",
      "name": "mix_plain_roll",
      "id": "mix_plain_roll",
      "resume": "allow",
      "log_model": false
    }
  },
  "data": {
    "dataset": {
      "name": "/workspace/datasets/mixture/mix.lance",
      "num_steps": 8,
      "frameskip": 5,
      "keys_to_load": [
        "pixels",
        "action"
      ],
      "keys_to_cache": [
        "action"
      ]
    }
  },
  "action_stats_pin": "expert"
}